# Example local run configuration for the VOLTIO app, 
# rename to run_app.env to use default values, change whatever's needed
# These paths are resolved relative to this file so they do not depend on a specific machine.
ROOT_DIR="$(cd "/home/{username}/git/banking-platform-voltio" && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR"
LOG_DIR="$ROOT_DIR/.dev-logs"

BACKEND_PORT="${BACKEND_PORT:-8080}"
BACKEND_TIMEOUT="${BACKEND_TIMEOUT:-120}"
SEED_PERSONAS="${SEED_PERSONAS:-true}"
